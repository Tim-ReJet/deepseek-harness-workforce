{
  "$ref": "#/definitions/DelegationPlan",
  "definitions": {
    "DelegationPlan": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "workforce.delegation-plan/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workOrder": {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "digest"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "assignee": {
                "type": "object",
                "properties": {
                  "agentInstanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "agentInstanceId",
                  "role"
                ],
                "additionalProperties": false
              },
              "ownedPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "assignee",
              "ownedPaths"
            ],
            "additionalProperties": false
          }
        },
        "workstreams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "objective": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "objective"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "requiredGates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recursion": {
          "type": "object",
          "properties": {
            "maxIterations": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxChildDepth": {
              "type": "integer",
              "minimum": 0
            },
            "noProgressThreshold": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "maxIterations",
            "maxChildDepth",
            "noProgressThreshold"
          ],
          "additionalProperties": false
        },
        "effectEnvelope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compensationRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string",
              "minLength": 1
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "class",
            "findings"
          ],
          "additionalProperties": false
        },
        "digest": {
          "$ref": "#/definitions/DelegationPlan/properties/workOrder/properties/digest"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "schema",
        "id",
        "workOrder",
        "revision",
        "workstreams",
        "requiredGates",
        "recursion",
        "effectEnvelope",
        "compensationRequirements",
        "risk",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
