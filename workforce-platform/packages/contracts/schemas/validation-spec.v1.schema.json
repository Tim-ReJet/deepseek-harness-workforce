{
  "$ref": "#/definitions/ValidationSpec",
  "definitions": {
    "ValidationSpec": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "workforce.validation-spec/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workOrder": {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "digest"
          ],
          "additionalProperties": false
        },
        "delegationPlan": {
          "$ref": "#/definitions/ValidationSpec/properties/workOrder"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "proposition": {
                "type": "string",
                "minLength": 1
              },
              "criticality": {
                "type": "string",
                "enum": [
                  "REQUIRED",
                  "OPTIONAL"
                ]
              },
              "procedures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minimumEvidenceStrength": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "proposition",
              "criticality",
              "procedures",
              "minimumEvidenceStrength"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "procedures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "independence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "independence"
            ],
            "additionalProperties": false
          }
        },
        "completeness": {
          "type": "object",
          "properties": {
            "requiredProducers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requireClosedAuthority": {
              "type": "boolean"
            },
            "requireClosedChildren": {
              "type": "boolean"
            }
          },
          "required": [
            "requiredProducers",
            "requireClosedAuthority",
            "requireClosedChildren"
          ],
          "additionalProperties": false
        },
        "verdictPolicy": {
          "type": "object",
          "properties": {
            "pass": {
              "type": "string",
              "minLength": 1
            },
            "fail": {
              "type": "string",
              "minLength": 1
            },
            "indeterminate": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pass",
            "fail",
            "indeterminate"
          ],
          "additionalProperties": false
        },
        "digest": {
          "$ref": "#/definitions/ValidationSpec/properties/workOrder/properties/digest"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "schema",
        "id",
        "workOrder",
        "delegationPlan",
        "assertions",
        "procedures",
        "completeness",
        "verdictPolicy",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
