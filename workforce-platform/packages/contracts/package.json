{
  "name": "@reactorjet/workforce-contracts",
  "version": "0.2.0",
  "description": "V2 canonical artifact schemas (Zod + generated JSON Schema) — the constitutional package every V2 Biro/Workforce/authority/Cell/provider component imports. workorder/v1 stays frozen in @workforce/workorder-protocol.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/workorder/index.ts": "./src/workorder/index.ts",
    "./src/common/digest.ts": "./src/common/digest.ts",
    "./src/common/ids.ts": "./src/common/ids.ts",
    "./src/common/extension.ts": "./src/common/extension.ts",
    "./src/execution-profile/binding.ts": "./src/execution-profile/binding.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:schemas": "tsx scripts/generate-json-schema.ts",
    "conformance": "tsx conformance/run-fixtures.ts"
  },
  "dependencies": {
    "@workforce/workorder-protocol": "workspace:*",
    "canonicalize": "^2.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "zod-to-json-schema": "3.24.6"
  }
}
