  },
  "dependencies": {
    "@reactorjet/workforce-contracts": "link:../../../../workforce-platform/packages/contracts",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^"
  }
